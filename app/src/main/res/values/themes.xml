<resources>
    <style name="Theme.Messages" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ios_window_bg</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="Theme.Messages.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ios_window_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Messages</item>
    </style>
</resources>
